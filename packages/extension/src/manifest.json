{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "0.5.0",
  "description": "LLM'in tarayıcıyı insan gibi sürdüğü otonom ajan — gerçek, giriş yapılmış oturumunda.",
  "permissions": ["tabs", "activeTab", "storage", "sidePanel", "alarms", "debugger", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Browser Agent panelini aç",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
